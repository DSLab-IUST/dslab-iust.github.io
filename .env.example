# Client ID of the GitHub OAuth App used for the Device Flow.
# Public by design — the Device Flow has no client secret.
VITE_GITHUB_CLIENT_ID=Ov23liXXXXXXXXXXXXXX

# Optional. URL of the Device Flow relay (see tools/oauth-relay/worker.js).
# Leave empty to hide the "Sign in with GitHub" tab and use tokens only.
VITE_GITHUB_OAUTH_RELAY=
